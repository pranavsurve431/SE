pages = [7,0,1,2,0,3,0,4,2,3,0,3,2,1,2,0,1,7,0,1]
size = 3

def simulate(name):
    frames = []
    recent = []
    faults = 0

    print("\n", name)
    print("Page\tFrames\t\tStatus")

    for p in pages:
        if p in frames:
            status = "Hit"
            if name == "LRU":
                recent.remove(p)
                recent.append(p)
        else:
            status = "Fault"
            faults += 1

            if len(frames) < size:
                frames.append(p)
            elif name == "FIFO":
                frames.pop(0)
                frames.append(p)
            else:
                old = recent.pop(0)
                frames.remove(old)
                frames.append(p)

            if name == "LRU":
                recent.append(p)

        print(p, "\t", frames, "\t", status)

    hits = len(pages) - faults
    print("Page Faults:", faults)
    print("Hit Ratio:", round(hits / len(pages), 2))

simulate("FIFO")
simulate("LRU")
